{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "favorite_genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disliked_genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favorite_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pacing": {
      "type": "string",
      "enum": [
        "fast",
        "medium",
        "slow",
        "any"
      ],
      "default": "any"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "challenging",
        "any"
      ],
      "default": "any"
    },
    "disliked_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "theme_mode": {
      "type": "string",
      "enum": [
        "bold",
        "minimal"
      ],
      "default": "bold"
    },
    "color_scheme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "dark"
    },
    "custom_primary": {
      "type": "string"
    },
    "custom_accent": {
      "type": "string"
    },
    "custom_secondary": {
      "type": "string"
    },
    "show_recommendations": {
      "type": "boolean",
      "default": true
    },
    "show_popular": {
      "type": "boolean",
      "default": true
    },
    "show_top_hamburger": {
      "type": "boolean",
      "default": false
    },
    "hide_top_bar": {
      "type": "boolean",
      "default": false
    },
    "top_bar_icons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths of nav items (not in bottom bar) to show as icon-only buttons in the top bar"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}