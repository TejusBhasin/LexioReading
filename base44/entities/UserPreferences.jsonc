{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "favorite_genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disliked_genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favorite_books": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pacing": {
      "type": "string",
      "enum": [
        "fast",
        "medium",
        "slow",
        "any"
      ],
      "default": "any"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "light",
        "medium",
        "challenging",
        "any"
      ],
      "default": "any"
    },
    "disliked_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "theme_mode": {
      "type": "string",
      "enum": [
        "bold",
        "minimal"
      ],
      "default": "bold"
    },
    "color_scheme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "dark"
    },
    "custom_primary": {
      "type": "string"
    },
    "custom_accent": {
      "type": "string"
    },
    "custom_secondary": {
      "type": "string"
    },
    "show_recommendations": {
      "type": "boolean",
      "default": true
    },
    "show_popular": {
      "type": "boolean",
      "default": true
    },
    "show_top_hamburger": {
      "type": "boolean",
      "default": false
    },
    "hide_top_bar": {
      "type": "boolean",
      "default": false
    },
    "top_bar_icons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths of nav items (not in bottom bar) to show as icon-only buttons in the top bar"
    },
    "simple_mode": {
      "type": "boolean",
      "default": false,
      "description": "Removes Clubs, Forums, Reviews tabs and hides certain genres/moods from promotion"
    },
    "hidden_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nav paths hidden from the menu (e.g. '/clubs', '/forums')"
    },
    "hidden_genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Genres hidden from promotion (still searchable)"
    },
    "hidden_moods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reading moods removed from mood options"
    },
    "content_mode": {
      "type": "string",
      "enum": [
        "books",
        "books_movies",
        "movies"
      ],
      "default": "books",
      "description": "Which media types the user sees across Lexio: books only, both books and movies, or movies only"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}