{
  "name": "BookClubSchedule",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "total_pages": {
      "type": "number"
    },
    "reading_pace": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "custom"
      ]
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "start_page": {
            "type": "number"
          },
          "end_page": {
            "type": "number"
          },
          "due_date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "club_id",
    "book_id",
    "book_title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "member_emails": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}