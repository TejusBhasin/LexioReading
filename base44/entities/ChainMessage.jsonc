{
  "name": "ChainMessage",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "chain_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "has_spoilers": {
      "type": "boolean",
      "default": false
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "club_id",
    "chain_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "member_emails": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}