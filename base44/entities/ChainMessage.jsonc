{
  "name": "ChainMessage",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "chain_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "has_spoilers": {
      "type": "boolean",
      "default": false
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "club_id",
    "chain_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "data.club_id": {
        "$in": [
          {
            "entity": "BookClubMember",
            "field": "data.club_id",
            "query": {
              "data.user_email": "{{user.email}}"
            }
          }
        ]
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}