{
  "name": "ReadingGoal",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "target_books": {
      "type": "number",
      "default": 12
    },
    "target_pages": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "year"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}