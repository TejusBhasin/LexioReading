{
  "name": "ReadingGoal",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "target_books": {
      "type": "number",
      "default": 12
    },
    "target_pages": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "year"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}