{
  "name": "Review",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_spoilers": {
      "type": "boolean",
      "default": false
    },
    "approved": {
      "type": "boolean",
      "default": true
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "book_id",
    "book_title",
    "rating",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.approved": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}