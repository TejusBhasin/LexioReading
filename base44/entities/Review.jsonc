{
  "name": "Review",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "book",
        "movie"
      ],
      "default": "book",
      "description": "Whether this review is for a book or a movie"
    },
    "rating": {
      "type": "number"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_spoilers": {
      "type": "boolean",
      "default": false
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "If false, review won't appear on public/recent reviews page"
    },
    "approved": {
      "type": "boolean",
      "default": true
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_email",
    "book_id",
    "book_title",
    "rating",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}