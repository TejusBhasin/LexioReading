{
  "name": "UserSafeness",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "is_banned": {
      "type": "boolean",
      "default": false
    },
    "ban_expires": {
      "type": "string",
      "description": "ISO date string. If set and past, ban is automatically lifted."
    },
    "banned_by_email": {
      "type": "string",
      "description": "Email of the user who issued the ban"
    },
    "banned_by_name": {
      "type": "string",
      "description": "Display name of the user who issued the ban"
    },
    "ban_source": {
      "type": "string",
      "enum": [
        "platform_admin",
        "school_admin"
      ],
      "default": "platform_admin",
      "description": "Who issued the ban: platform admin or school admin"
    },
    "ban_issued_at": {
      "type": "string",
      "description": "ISO date string of when the ban was issued (for cooldown tracking)"
    },
    "banned_from_forums": {
      "type": "boolean",
      "default": false
    },
    "banned_from_clubs": {
      "type": "boolean",
      "default": false
    },
    "banned_from_comments": {
      "type": "boolean",
      "default": false
    },
    "banned_from_discussions": {
      "type": "boolean",
      "default": false
    },
    "banned_from_chat": {
      "type": "boolean",
      "default": false
    },
    "ban_reason": {
      "type": "string"
    },
    "warning_count": {
      "type": "number",
      "default": 0,
      "description": "Number of upheld content violations. 1 = first warning, 2 = second warning, 3 = permanent ban."
    },
    "warning_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of reasons for each warning"
    },
    "last_warning_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}