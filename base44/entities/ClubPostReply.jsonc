{
  "name": "ClubPostReply",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "club_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "created_by_id": {
        "$exists": true
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}