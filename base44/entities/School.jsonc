{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "join_code": {
      "type": "string"
    },
    "theme_primary": {
      "type": "string",
      "default": "#f5a623"
    },
    "theme_accent": {
      "type": "string",
      "default": "#e8854a"
    },
    "theme_secondary": {
      "type": "string",
      "default": "#1a1a1a"
    },
    "theme_locked": {
      "type": "boolean",
      "default": true
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features to disable: 'vault', 'forums', 'clubs', 'chat', 'reviews', 'wrapped', 'discover'"
    },
    "require_setup_tour": {
      "type": "boolean",
      "default": false,
      "description": "If true, members who skipped the setup tour will be required to complete it."
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "allow_dual_mode": {
      "type": "boolean",
      "default": false
    },
    "age_restriction": {
      "type": "string",
      "enum": [
        "all",
        "teen",
        "adult"
      ],
      "default": "all",
      "description": "Mass age restriction for all school members. 'all' = no restriction, 'teen' = teen-appropriate only, 'adult' = adult content visible"
    }
  },
  "required": [
    "name",
    "creator_email"
  ],
  "rls": {
    "create": {
      "data.creator_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.creator_email": "{{user.email}}"
        },
        {
          "id": {
            "$in": [
              {
                "entity": "SchoolMember",
                "field": "data.school_id",
                "query": {
                  "data.user_email": "{{user.email}}",
                  "data.kicked": false
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.creator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.creator_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}