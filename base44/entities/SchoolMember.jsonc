{
  "name": "SchoolMember",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "semi_admin",
        "member"
      ],
      "default": "member"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permissions for semi_admin role: 'view_members', 'view_member_data', 'restrict_individual', 'kick_members', 'manage_restrictions', 'manage_theme'"
    },
    "individual_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features restricted for this specific student only, in addition to school-wide restrictions"
    },
    "dual_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "currently_school_mode": {
      "type": "boolean",
      "default": true
    },
    "joined_date": {
      "type": "string"
    },
    "kicked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "school_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}