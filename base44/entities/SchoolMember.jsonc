{
  "name": "SchoolMember",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "semi_admin",
        "member"
      ],
      "default": "member"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permissions for semi_admin role: 'view_members', 'view_member_data', 'restrict_individual', 'kick_members', 'manage_restrictions', 'manage_theme'"
    },
    "individual_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features restricted for this specific student only, in addition to school-wide restrictions"
    },
    "pending_class_id": {
      "type": "string",
      "description": "Class ID the student is requesting to change to (empty if no pending request)"
    },
    "pending_class_name": {
      "type": "string"
    },
    "pending_role": {
      "type": "string",
      "description": "Role the member is requesting (e.g. 'semi_admin'). Empty if no pending request."
    },
    "dual_mode_enabled": {
      "type": "boolean",
      "default": false
    },
    "currently_school_mode": {
      "type": "boolean",
      "default": true
    },
    "joined_date": {
      "type": "string"
    },
    "kicked": {
      "type": "boolean",
      "default": false
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "If true, this member is hidden from other school admins and members. Used for Lexio admin invisible access."
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "True if the student has been formally offboarded. Data is preserved; school access is revoked."
    },
    "archived_at": {
      "type": "string",
      "description": "ISO date when the student was archived/offboarded"
    },
    "archived_by": {
      "type": "string",
      "description": "Email of the admin who archived this student"
    },
    "archive_reason": {
      "type": "string",
      "description": "Reason for offboarding (e.g. 'graduated', 'left school', 'transferred')"
    }
  },
  "required": [
    "school_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": {
        "$exists": true
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}