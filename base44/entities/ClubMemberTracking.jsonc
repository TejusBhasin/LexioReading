{
  "name": "ClubMemberTracking",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member"
    },
    "pages_read": {
      "type": "number",
      "default": 0
    },
    "time_spent_minutes": {
      "type": "number",
      "default": 0
    },
    "sessions_completed": {
      "type": "number",
      "default": 0
    },
    "mood_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "mood": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "joined_date": {
      "type": "string"
    },
    "left_date": {
      "type": "string"
    }
  },
  "required": [
    "club_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.club_id": {
        "$in": [
          {
            "entity": "ReadingClub",
            "field": "id",
            "query": {
              "created_by_id": "{{user.id}}"
            }
          }
        ]
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "created_by_id": "{{user.id}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "created_by_id": "{{user.id}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.club_id": {
        "$in": [
          {
            "entity": "ReadingClub",
            "field": "id",
            "query": {
              "created_by_id": "{{user.id}}"
            }
          }
        ]
      }
    }
  }
}