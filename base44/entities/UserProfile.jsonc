{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "show_library": {
      "type": "boolean",
      "default": true
    },
    "show_stats": {
      "type": "boolean",
      "default": true
    },
    "show_reviews": {
      "type": "boolean",
      "default": true
    },
    "tc_agreed": {
      "type": "boolean",
      "default": false
    },
    "tc_agreed_date": {
      "type": "string"
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "age_filter": {
      "type": "string",
      "enum": [
        "all",
        "teen",
        "adult"
      ],
      "default": "all"
    },
    "blacklisted_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "reading_reminder_days": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reading_reminder_time": {
      "type": "string"
    },
    "whatsapp_phone": {
      "type": "string"
    },
    "whatsapp_reminders_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email"
  ]
}