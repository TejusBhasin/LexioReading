{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "show_library": {
      "type": "boolean",
      "default": true
    },
    "show_stats": {
      "type": "boolean",
      "default": true
    },
    "show_reviews": {
      "type": "boolean",
      "default": true
    },
    "show_email": {
      "type": "boolean",
      "default": false
    },
    "show_real_name": {
      "type": "boolean",
      "default": false
    },
    "display_name": {
      "type": "string"
    },
    "tc_agreed": {
      "type": "boolean",
      "default": false
    },
    "tc_agreed_date": {
      "type": "string"
    },
    "tc_version": {
      "type": "string"
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "age_filter": {
      "type": "string",
      "enum": [
        "all",
        "teen",
        "adult"
      ],
      "default": "all"
    },
    "blacklisted_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_skipped": {
      "type": "boolean",
      "default": false
    },
    "movie_mode_prompted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the one-time movie mode popup has been shown to this user"
    },
    "librarian_pin": {
      "type": "string",
      "description": "PIN required to exit Librarian Mode kiosk"
    },
    "app_lock_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the app lock screen is enabled"
    },
    "app_lock_pin": {
      "type": "string",
      "description": "PIN required to unlock the app"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user passed Didit identity verification and earns a blue badge"
    },
    "verified_real_name": {
      "type": "string",
      "description": "Real name submitted at verification start; displayed instead of username once verified"
    },
    "verified_at": {
      "type": "string",
      "description": "ISO timestamp when verification was approved"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "in_progress",
        "awaiting_user",
        "in_review",
        "approved",
        "declined",
        "resubmitted",
        "abandoned",
        "expired"
      ],
      "default": "not_started"
    },
    "didit_session_id": {
      "type": "string",
      "description": "Didit session id returned when the verification session was created"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.is_public": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}