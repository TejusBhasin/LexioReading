{
  "name": "BookClubMember",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member"
    }
  },
  "required": [
    "club_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}