{
  "name": "BookClubChain",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "schedule_id": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_page": {
      "type": "number"
    },
    "end_page": {
      "type": "number"
    },
    "due_date": {
      "type": "string"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "members_participated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "club_id",
    "book_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "member_emails": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "member_emails": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.club_id": {
            "$in": [
              {
                "$query": {
                  "collection": "ReadingClub",
                  "filter": {
                    "creator_email": "{{user.email}}"
                  },
                  "pipeline": [
                    {
                      "$project": {
                        "_id": 0,
                        "id": "$id"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}