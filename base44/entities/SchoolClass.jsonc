{
  "name": "SchoolClass",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "student_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features to disable for students in this class: 'vault', 'forums', 'clubs', 'chat', 'reviews', 'wrapped', 'discover', 'book_creator'"
    },
    "enable_assignments": {
      "type": "boolean",
      "default": false,
      "description": "If true, students in this class see an Assignments tab"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "class_name",
    "teacher_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "data.student_emails": "{{user.email}}"
        },
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "SchoolMember",
                "field": "data.school_id",
                "query": {
                  "data.user_email": "{{user.email}}",
                  "data.kicked": false
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.school_id": {
            "$in": [
              {
                "entity": "School",
                "field": "id",
                "query": {
                  "data.creator_email": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}