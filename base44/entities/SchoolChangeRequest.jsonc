{
  "name": "SchoolChangeRequest",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "admin_email": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "content_isolation",
        "email_domain"
      ],
      "default": "content_isolation"
    },
    "requested_email_domain": {
      "type": "string",
      "description": "The email domain requested for auto-join (e.g. 'school.org')"
    },
    "reason": {
      "type": "string",
      "description": "School admin's explanation for the request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "description": "Platform admin's response notes"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "admin_email",
    "request_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}