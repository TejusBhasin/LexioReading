{
  "name": "ReadingClub",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "current_book_id": {
      "type": "string"
    },
    "current_book_title": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "club_type": {
      "type": "string",
      "enum": [
        "administrative",
        "discussion",
        "collaborative",
        "logging"
      ],
      "default": "discussion"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "join_code": {
      "type": "string"
    },
    "tracking_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What member data admin tracks: 'pages_read', 'time_spent', 'mood', 'notes', etc."
    },
    "allow_chat": {
      "type": "boolean",
      "default": true
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "creator_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.is_visible": true
        },
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}