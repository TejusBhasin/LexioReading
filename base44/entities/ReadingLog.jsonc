{
  "name": "ReadingLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "time_spent_minutes": {
      "type": "number"
    },
    "progress_note": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "mood": {
      "type": "string"
    },
    "session_started": {
      "type": "string"
    },
    "session_ended": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "book_title",
    "date"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "SchoolMember",
                "field": "data.user_email",
                "query": {
                  "data.school_id": {
                    "$in": [
                      {
                        "entity": "School",
                        "field": "id",
                        "query": {
                          "created_by_id": "{{user.id}}"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "data.member_emails",
                "query": {
                  "created_by_id": "{{user.id}}",
                  "data.club_type": "logging"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "SchoolMember",
                "field": "data.user_email",
                "query": {
                  "data.school_id": {
                    "$in": [
                      {
                        "entity": "School",
                        "field": "id",
                        "query": {
                          "created_by_id": "{{user.id}}"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "data.member_emails",
                "query": {
                  "created_by_id": "{{user.id}}",
                  "data.club_type": "logging"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "SchoolMember",
                "field": "data.user_email",
                "query": {
                  "data.school_id": {
                    "$in": [
                      {
                        "entity": "School",
                        "field": "id",
                        "query": {
                          "created_by_id": "{{user.id}}"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "data.member_emails",
                "query": {
                  "created_by_id": "{{user.id}}",
                  "data.club_type": "logging"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}