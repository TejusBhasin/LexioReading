{
  "name": "UserLibrary",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "book_author": {
      "type": "string"
    },
    "book_cover": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "book",
        "movie"
      ],
      "default": "book",
      "description": "Whether this library entry is a book or a movie"
    },
    "status": {
      "type": "string",
      "enum": [
        "want_to_read",
        "reading",
        "finished",
        "dropped"
      ],
      "default": "want_to_read"
    },
    "rating": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "current_page": {
      "type": "number"
    },
    "page_count": {
      "type": "number",
      "description": "Total page count (used for manually added books)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date_added": {
      "type": "string"
    },
    "date_finished": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "book_id",
    "book_title",
    "book_author"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_email": {
            "$in": [
              {
                "entity": "UserProfile",
                "field": "data.user_email",
                "query": {
                  "data.is_public": true,
                  "data.show_library": true
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}