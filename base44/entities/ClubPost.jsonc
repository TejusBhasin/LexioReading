{
  "name": "ClubPost",
  "type": "object",
  "properties": {
    "club_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "club_id",
    "user_email",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "data.member_emails": "{{user.email}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.club_id": {
            "$in": [
              {
                "entity": "ReadingClub",
                "field": "id",
                "query": {
                  "created_by_id": "{{user.id}}"
                }
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}