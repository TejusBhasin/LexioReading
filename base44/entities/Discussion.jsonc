{
  "name": "Discussion",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "book_title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "has_spoilers": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "book_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "email": {
          "$exists": true
        }
      }
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}