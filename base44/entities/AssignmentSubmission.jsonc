{
  "name": "AssignmentSubmission",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "auto_completed"
      ],
      "default": "pending"
    },
    "submitted_book_title": {
      "type": "string"
    },
    "time_spent_minutes": {
      "type": "number"
    },
    "auto_completed": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string"
    },
    "teacher_notes": {
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "student_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}