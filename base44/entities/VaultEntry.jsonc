{
  "name": "VaultEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "card_name": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url_1": {
      "type": "string"
    },
    "image_url_2": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "card_name"
  ],
  "rls": {
    "create": {
      "user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}