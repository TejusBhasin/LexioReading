{
  "name": "VaultEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "card_name": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url_1": {
      "type": "string"
    },
    "image_url_2": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "card_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}