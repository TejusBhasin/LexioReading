{
  "name": "BlockedPattern",
  "type": "object",
  "properties": {
    "pattern": {
      "type": "string"
    },
    "pattern_type": {
      "type": "string",
      "enum": [
        "email",
        "username"
      ],
      "default": "email"
    },
    "reason": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "pattern",
    "pattern_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}