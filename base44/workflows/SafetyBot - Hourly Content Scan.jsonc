{
  "name": "SafetyBot - Hourly Content Scan",
  "description": "Hourly scan of all user-generated content (reviews, discussions, forum posts/comments, club posts/replies, chain messages) for 13+ safety. Auto-deletes inappropriate content. Then flag it and put it in the admin dashboard flagged content for admin to take further action",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 4,
      "interval_unit": "hours",
      "interval_anchor": "2026-07-09T20:43:09.039000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "safetybot_hourly_content_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "moderateContent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "moderateContent"
  }
}